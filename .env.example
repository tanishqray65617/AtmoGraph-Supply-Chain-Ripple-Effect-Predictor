# Environment configuration for AtmoGraph

# Application settings
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=atmograph_super_secret_jwt_key_2026_supply_chain

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=atmograph_secret_2026
NEO4J_DATABASE=neo4j

# ML & NLP Engine Configuration
NLP_MODEL_NAME=en_core_web_sm
GNN_EMBEDDING_DIM=64
GNN_HIDDEN_CHANNELS=128
GNN_NUM_LAYERS=3
GNN_DROPOUT=0.2

# WebSocket & Event Streaming
WS_HEARTBEAT_INTERVAL_SEC=5
SIMULATION_TICK_RATE_MS=1500
